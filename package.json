{
  "name": "scotdance-splits",
  "description": "Automatically split dancer registrations into balanced age groups with bib numbers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
